{
  "index_patterns": [
    "pdp-findings-*"
  ],
  "template": {
    "settings": {
      "index.number_of_shards": "1",
      "index.number_of_replicas": "1",
      "index.refresh_interval": "5s",
      "mapping.total_fields.limit": "2000"
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "schema_version": {
          "type": "keyword"
        },
        "finding_id": {
          "type": "keyword"
        },
        "control_id": {
          "type": "keyword"
        },
        "scope.processing_activity_id": {
          "type": "keyword"
        },
        "scope.asset_ids": {
          "type": "keyword"
        },
        "status": {
          "type": "keyword"
        },
        "severity": {
          "type": "keyword"
        },
        "statement": {
          "type": "text"
        },
        "evidence": {
          "type": "keyword"
        },
        "assessment_id": {
          "type": "keyword"
        },
        "remediation_id": {
          "type": "keyword"
        },
        "exception_id": {
          "type": "keyword"
        },
        "created_at": {
          "type": "date"
        },
        "updated_at": {
          "type": "date"
        },
        "owner": {
          "type": "keyword"
        },
        "risk_owner": {
          "type": "keyword"
        },
        "legal_review_state": {
          "type": "keyword"
        },
        "notes": {
          "type": "text"
        }
      }
    }
  },
  "priority": 200,
  "_meta": {
    "framework": "PDP Control Framework",
    "version": "0.10.0-rc2"
  }
}