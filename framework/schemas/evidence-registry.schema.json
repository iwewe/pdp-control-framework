{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/pdp-control-framework/framework/schemas/evidence-registry.schema.json",
  "title": "PDP Evidence Registry Entry",
  "type": "object",
  "required": [
    "schema_version",
    "registry_id",
    "evidence_id",
    "index",
    "state",
    "registered_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.9"
    },
    "registry_id": {
      "type": "string",
      "pattern": "^REG-"
    },
    "evidence_id": {
      "type": "string",
      "pattern": "^EV-"
    },
    "index": {
      "type": "string"
    },
    "document_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "enum": [
        "ACTIVE",
        "STALE",
        "SUPERSEDED",
        "RETIRED"
      ]
    },
    "registered_at": {
      "type": "string",
      "format": "date-time"
    },
    "retention_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "integrity_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "processing_activity_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "asset_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "control_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^PDP-"
      }
    },
    "legal_requirement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^LR-"
      }
    }
  },
  "additionalProperties": false
}