# Environment variables for real-runtime validation scripts.
#
# Copy to .env, fill in real values, and load it into your shell before
# running the scripts below. Never commit a filled-in .env file --
# .gitignore already excludes .env.
#
# See implementations/wazuh/DEPLOYMENT.md for full lab setup guidance.

# --- Wazuh Server API /logtest harness ------------------------------------
# Used by: implementations/wazuh/tests/harness/run_api_logtest.py
WAZUH_API_URL=https://127.0.0.1:55000
WAZUH_API_USER=
WAZUH_API_PASSWORD=
WAZUH_API_VERIFY_TLS=false
PDP_ASSET_ID=ASSET-LAB-001
PDP_PROCESSING_ACTIVITY_ID=PA-LAB-001

# --- Wazuh Indexer / Dashboard real import validation ----------------------
# Used by: release/runtime-validation/dashboard/validate_real_import.py
PDP_INDEXER_URL=https://127.0.0.1:9200
PDP_INDEXER_USER=admin
PDP_INDEXER_PASSWORD=
PDP_DASHBOARD_URL=https://127.0.0.1
PDP_DASHBOARD_USER=admin
PDP_DASHBOARD_PASSWORD=
PDP_VERIFY_TLS=false
PDP_SECURITY_TENANT=global
