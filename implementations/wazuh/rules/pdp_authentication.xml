<group name="pdp,authentication,">
  <!-- PDP Control Framework draft rules. Technical detections only. -->

  <rule id="110001" level="5">
    <if_group>authentication_failed</if_group>
    <description>PDP context candidate: authentication failure on monitored asset.</description>
    <group>pdp_event,pdp_authentication,pdp_evt_auth_001,pdp_req_mon_001,pdp_control_acc_003,</group>
  </rule>

  <rule id="110002" level="10" frequency="8" timeframe="120">
    <if_matched_sid>110001</if_matched_sid>
    <same_srcip />
    <description>PDP context candidate: repeated authentication failures from same source.</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>pdp_event,pdp_authentication,pdp_evt_auth_001,pdp_req_inc_001,pdp_control_inc_001,</group>
  </rule>

  <rule id="110003" level="5">
    <if_group>authentication_success</if_group>
    <description>PDP context candidate: successful authentication event available for audit correlation.</description>
    <group>pdp_event,pdp_authentication,pdp_audit,pdp_req_log_001,</group>
  </rule>
</group>
